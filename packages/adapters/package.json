{
  "name": "@gtm-trust-kernel/adapters",
  "version": "0.2.0",
  "type": "module",
  "description": "CRM adapter contract, canonical model and trust envelope, and the mock adapter.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pretzelslab/gtm-trust-kernel.git",
    "directory": "packages/adapters"
  },
  "homepage": "https://github.com/pretzelslab/gtm-trust-kernel/tree/master/packages/adapters#readme",
  "bugs": {
    "url": "https://github.com/pretzelslab/gtm-trust-kernel/issues"
  },
  "keywords": ["crm", "adapter", "salesforce", "canonical-model", "trust-envelope", "gtm"],
  "files": ["dist", "CHANGELOG.md"],
  "engines": { "node": ">=22" },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "source": "./src/types.ts",
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./types.js": {
      "source": "./src/types.ts",
      "types": "./dist/src/types.d.ts",
      "default": "./dist/src/types.js"
    },
    "./mock.js": {
      "source": "./src/mock.ts",
      "types": "./dist/src/mock.d.ts",
      "default": "./dist/src/mock.js"
    },
    "./salesforce.js": {
      "source": "./src/salesforce.ts",
      "types": "./dist/src/salesforce.d.ts",
      "default": "./dist/src/salesforce.js"
    },
    "./model/canonical.js": {
      "source": "./src/model/canonical.ts",
      "types": "./dist/src/model/canonical.d.ts",
      "default": "./dist/src/model/canonical.js"
    },
    "./model/trust.js": {
      "source": "./src/model/trust.ts",
      "types": "./dist/src/model/trust.d.ts",
      "default": "./dist/src/model/trust.js"
    },
    "./fixtures": {
      "source": "./test/fixtures.ts",
      "types": "./dist/test/fixtures.d.ts",
      "default": "./dist/test/fixtures.js"
    },
    "./contract/adapter": {
      "source": "./test/contract/adapter.contract.ts",
      "types": "./dist/test/contract/adapter.contract.d.ts",
      "default": "./dist/test/contract/adapter.contract.js"
    },
    "./contract/secondSource": {
      "source": "./test/contract/secondSource.contract.ts",
      "types": "./dist/test/contract/secondSource.contract.d.ts",
      "default": "./dist/test/contract/secondSource.contract.js"
    }
  },
  "peerDependencies": {
    "vitest": ">=2.1.3 <6"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  }
}
