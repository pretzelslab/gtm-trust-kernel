# Salesforce connected app (OAuth 2.0 client credentials flow)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=
SF_API_VERSION=v62.0
# Optional. Where the access token is cached (defaults inside the adapters package).
SF_TOKEN_CACHE_PATH=
# Optional. How your org captures activity: auto (email/calendar sync writes
# Tasks and Events) or manual (reps log by hand). Unset is treated as manual,
# and activity-based checks are reported as not measured.
SF_ACTIVITY_CAPTURE=
# Optional. Most Enhanced Note bodies to fetch in full per run, for notes whose
# preview is cut off (default 200; 0 never fetches). Past it, note length is a floor.
SF_NOTE_FULLTEXT_FETCH_LIMIT=

# Anthropic, used only by the optional --narrative summary
ANTHROPIC_API_KEY=
NARRATIVE_MODEL=
# Optional, used only by `npm run narrative:smoke` (packages/readiness) to
# print an estimated cost line; USD per million tokens. Omit either to skip
# the cost line and print token counts only.
NARRATIVE_INPUT_COST_PER_MTOK=
NARRATIVE_OUTPUT_COST_PER_MTOK=

