# Salesforce connected app (JWT or client credentials)
SF_CLIENT_ID=
SF_CLIENT_SECRET=
SF_INSTANCE_URL=
SF_API_VERSION=v62.0

# HubSpot private app token
HUBSPOT_TOKEN=

# Anthropic
ANTHROPIC_API_KEY=
MODEL_VERSION=claude-sonnet-4-5
PROMPT_VERSION=v1

# Readiness package's narrative pass (Phase E) -- distinct from MODEL_VERSION
# above, which belongs to the kernel's write-proposal flow.
NARRATIVE_MODEL=
# Optional, used only by `npm run narrative:smoke` (packages/readiness) to
# print an estimated cost line; USD per million tokens. Omit either to skip
# the cost line and print token counts only.
NARRATIVE_INPUT_COST_PER_MTOK=
NARRATIVE_OUTPUT_COST_PER_MTOK=

# Safety
WRITES_ENABLED=false
DAILY_COST_CAP_USD=5
PROPOSAL_TTL_MS=14400000
